<html>
  <head>
    <style>
      body {
        font-family: Arial, sans-serif;
        color: #333;
      }
      .container {
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 5px;
        max-width: 500px;
        margin: auto;
      }
      .btn {
        display: inline-block;
        background: #4f46e5;
        color: white;
        padding: 12px 20px;
        text-decoration: none;
        border-radius: 4px;
        font-weight: bold;
        margin-top: 15px;
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <h2>Reset Your Password</h2>
      <p>Hi {{name}},</p>
      <p>You requested to reset your password for your account. Click the button
        below to proceed:</p>
      <a href='{{resetUrl}}' class='btn'>Reset Password</a>
      <p style='margin-top: 20px; font-size: 12px; color: #6b7280;'>If you
        didn't request this, you can safely ignore this email.</p>
    </div>
  </body>
</html>